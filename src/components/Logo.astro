<style>
  img {
    display: block;
    width: 75px;
  }

  @media screen and (max-width: 520px) {
    img {
      display: none;
    }
  }
</style>

<a href="/">
  <img id="site-logo" alt="Blog Logo" src="/assets/logo.webp" width="75" height="50" />
</a>

<script is:inline>
  const lightLogo = '/assets/logo2.webp'
  const darkLogo = '/assets/logo.webp'

  const updateLogo = () => {
    const logo = document.getElementById('site-logo')

    if (!logo) {
      return
    }

    logo.src = document.documentElement.classList.contains('theme-dark') ? darkLogo : lightLogo
  }

  const observeTheme = () => {
    updateLogo()

    const observer = new MutationObserver(updateLogo)
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
  }

  document.addEventListener('astro:page-load', updateLogo)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeTheme, { once: true })
  } else {
    observeTheme()
  }
</script>
