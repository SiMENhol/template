---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'hoelland';
const description = 'CV';
const permalink = `${Astro.site.href}about`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="container">
    <h1>About</h1>
    <figure class="about-image">
      <img src="/assets/portrett.jpg" alt="Illustration of a portrait" width="330">
      <figcaption>
       This is me
      </figcaption>
    </figure>
    <p> Hi </p>
    <h3> Experience </h3>
    <p> Currently working at  </p>
    <br>
    <h3> Education </h3>
    <p> Master UiA </p>
</BaseLayout>

<style>
  .about-image {
    float: right;
    margin: -3em -7em 2em 2em;
    max-width: 300px;
  }

  .about-image img {
    border-radius: 8px;
    margin-bottom: 1.5em;
  }

  @media (max-width: 1020px) {
    .about-image {
      float: none;
      margin: 0 auto 2em;
    }
  }
</style>
